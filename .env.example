# Copie para .env e preencha. O .env nunca vai para o git.

# URL do projeto Supabase (Project Settings > API > Project URL)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave publica anon/publishable (a mesma que o app Next.js usa).
# NAO use a service_role: ela ignora o RLS.
SUPABASE_KEY=sua-chave-anon-aqui

# Porta do servidor (opcional; sem ela, 3000)
PORT=3000
