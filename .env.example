# Copie para .env e preencha. O .env nunca vai para o git.

# URL do projeto Supabase (Project Settings > API > Project URL)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave SECRETA service_role (Project Settings > API Keys > secret).
# A API nao tem login, entao precisa dela para gravar: ela ignora o RLS.
# Nunca coloque esta chave no app Next.js nem no celular.
SUPABASE_KEY=sua-chave-secreta-aqui

# Porta do servidor (opcional; sem ela, 3000)
PORT=3000
